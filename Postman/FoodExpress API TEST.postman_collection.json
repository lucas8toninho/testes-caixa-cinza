	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"pm.test(\"Cenário 1: Login válido - Status 200 e access token\", function () {",
					"    if (pm.response.code === 200) {",
					"        pm.response.to.have.status(200);",
					"        ",
					"        var jsonData = pm.response.json();",
					"        pm.expect(jsonData).to.have.property('access_token');",
					"    }",
					"});",
					"",
					"pm.test(\"Cenário 2: Senha incorreta - Erro de autenticação\", function () {",
					"    if (pm.response.code === 401) {",
					"        pm.response.to.have.status(401);",
					"        var jsonData = pm.response.json();",
					"    ",
					"        pm.expect(jsonData).to.satisfy(function(body) {",
					"            return body.message || body.error;",
					"        });",
					"    }",
					"});",
					"",
					"",
					"pm.test(\"Cenário 3: Usuário inexistente - Acesso negado\", function () {",
					"    if (pm.response.code === 404 || pm.response.code === 401) {",
					"        pm.expect(pm.response.code).to.be.oneOf([401, 404]);",
					"    }",
					"});",
					"",
					"pm.test(\"Cenário 4: Campos vazios - Erro de validação\", function () {",
					"    if (pm.response.code === 400) {",
					"        pm.response.to.have.status(400);",
					"    }",
					"});",
					"",
					"",
					"pm.test(\"Cenário 5: Credenciais inválidas - Mensagem de erro presente\", function () {",
					"    var jsonData = pm.response.json();",
					"",
					"    pm.expect(jsonData).to.satisfy(function(body) {",
					"        return body.message !== undefined || body.error !== undefined || body.mensagem !== undefined;",
					"    });",
					"});"
				]
			}
		},
